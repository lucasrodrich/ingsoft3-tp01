server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # La dirección del backend y el DNS llegan por variables de entorno: en
    # compose, el nombre del servicio y el DNS interno de Docker; en Render,
    # la URL pública de la api de ESTE entorno y un DNS público (8.8.8.8).
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        proxy_pass $backend_api;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        proxy_pass $backend_api/health;
        proxy_ssl_server_name on;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
